# ==============================================================================
# Rhino.Compute on Linux Container
# Based on the official McNeel Guide:
# https://developer.rhino3d.com/guides/compute/compute-linux-getting-started/
# Base OS: Ubuntu 24.04 LTS (Noble Numbat)
# ==============================================================================

FROM --platform=linux/amd64 ubuntu:noble

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# 1. Install prerequisites
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    gnupg \
    procps \
    nano \
    findutils \
    libgdiplus \
    fontconfig \
    libicu-dev \
    libssl-dev \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Microsoft .NET 9.0 (McNeel official requirement: 9.0.102)
RUN wget https://dotnet.microsoft.com/download/dotnet/scripts/v1/dotnet-install.sh -O dotnet-install.sh \
    && chmod +x ./dotnet-install.sh \
    && ./dotnet-install.sh --version 9.0.102 --install-dir /usr/share/dotnet \
    && ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet \
    && rm -f dotnet-install.sh

# 3. Add McNeel package repository to sources (using official GPG key)
RUN wget -qO- https://mcneel-packages.s3.amazonaws.com/mcneel-packages.gpg.key | gpg --dearmor -o /usr/share/keyrings/mcneel-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/mcneel-archive-keyring.gpg] https://mcneel-packages.s3.amazonaws.com/deb stable main" | tee /etc/apt/sources.list.d/mcneel.list

# 4. Install rhino-compute and yak-cli
RUN apt-get update && apt-get install -y --no-install-recommends \
    rhino-compute \
    yak-cli \
    && rm -rf /var/lib/apt/lists/*

# 4b. Patch headless Linux native C++ issues in McNeel libraries
RUN python3 -c "\
with open('/usr/lib/rhino3d/librhcommon_c.so', 'r+b') as f:\
    f.seek(0x415244);\
    f.write(bytes([0x31, 0xc0, 0xc3]) + bytes([0x90] * 21))\n\
with open('/usr/lib/rhino3d/libRhinoCore.so', 'r+b') as f:\
    f.seek(0x268bfa0);\
    f.write(bytes([0xf3, 0x0f, 0x1e, 0xfa, 0x31, 0xc0, 0xc3, 0x90]));\
    f.seek(0x2694780);\
    f.write(bytes([0xf3, 0x0f, 0x1e, 0xfa, 0xc3, 0x90, 0x90, 0x90]))\n\
"

# 5. Install Miller_Moth plugin through Yak package manager
# Installs for both root and the rhino-compute service user, and links into Grasshopper Libraries
RUN yak install Miller_Moth \
    && runuser -u rhino-compute -- yak install Miller_Moth \
    && mkdir -p /var/lib/rhino-compute/.config/Grasshopper/Libraries /root/.config/Grasshopper/Libraries \
    && find / -name "MillerMoth.gha" -exec cp -n {} /var/lib/rhino-compute/.config/Grasshopper/Libraries/ \; 2>/dev/null || true \
    && find / -name "MillerMoth.gha" -exec cp -n {} /root/.config/Grasshopper/Libraries/ \; 2>/dev/null || true \
    && chown -R rhino-compute:rhino-compute /var/lib/rhino-compute 2>/dev/null || true

# 6. Setup directories and permissions
RUN mkdir -p /etc/rhino-compute /var/log/rhino-compute \
    && chown -R rhino-compute:rhino-compute /var/log/rhino-compute /etc/rhino-compute

# 7. Create container entrypoint wrapper to handle environment variables and ports
RUN printf '#!/bin/bash\n\
set -e\n\
\n\
# Set listening URLs based on PORT or RHINO_COMPUTE_URLS\n\
PORT_NUM="${PORT:-5000}"\n\
export RHINO_COMPUTE_URLS="${RHINO_COMPUTE_URLS:-http://0.0.0.0:${PORT_NUM}}"\n\
export ASPNETCORE_URLS="${RHINO_COMPUTE_URLS}"\n\
\n\
# Configure /etc/rhino-compute/environment\n\
if [ -n "$RHINO_TOKEN" ] || [ -n "$RHINO_COMPUTE_KEY" ] || [ ! -f /etc/rhino-compute/environment ]; then\n\
    cat <<EOF > /etc/rhino-compute/environment\n\
RHINO_TOKEN=${RHINO_TOKEN:-}\n\
RHINO_COMPUTE_KEY=${RHINO_COMPUTE_KEY:-}\n\
RHINO_COMPUTE_CREATE_HEADLESS_DOC=true\n\
RHINO_COMPUTE_LOG_PATH=/var/log/rhino-compute\n\
RHINO_COMPUTE_URLS=${RHINO_COMPUTE_URLS}\n\
PORT=${PORT_NUM}\n\
EOF\n\
    chown -R rhino-compute:rhino-compute /etc/rhino-compute 2>/dev/null || true\n\
fi\n\
\n\
mkdir -p /var/log/rhino-compute\n\
chown -R rhino-compute:rhino-compute /var/log/rhino-compute 2>/dev/null || true\n\
\n\
exec "$@"\n' > /entrypoint.sh && chmod +x /entrypoint.sh

# Default port: 5000 (McNeel standard)
ENV PORT=5000
EXPOSE 80
EXPOSE 5000
EXPOSE 8080

HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f -H "RhinoComputeKey: ${RHINO_COMPUTE_KEY}" http://localhost:${PORT:-5000}/healthcheck || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["rhino-compute-start"]
