                        <chunk name="InputParam" index="4">
                          <items count="10">
                            <item name="AllowTreeAccess" type_name="gh_bool" type_code="1">true</item>
                            <item name="Description" type_name="gh_string" type_code="10">A positive number in Rhino model units for the size of grid
cells at which the input _geometry will be subdivided for direct sun
analysis. The smaller the grid size, the higher the resolution of
the analysis and the longer the calculation will take.  So it is
recommended that one start with a large value here and decrease
the value as needed. However, the grid size should usually be
smaller than the dimensions of the smallest piece of the _geometry
and context_ in order to yield meaningful results.</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">80994d93-c5fd-4952-8758-852ddcb10aa6</item>
                            <item name="Name" type_name="gh_string" type_code="10">_grid_size</item>
