#!/usr/bin/env node

// Polyfill for Azure SDK
global.crypto = require('crypto');

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('compute.rhino3d.appserver:server');
var http = require('http');
var throng = require('throng');
var azureService = require('../services/azure-service'); // Import the service

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

const WORKERS = process.env.WEB_CONCURRENCY || 1;

throng({
  workers: WORKERS,
  master: master,  // Run master function once
  start: start     // Run start function for each worker
});

// Master process handles the watchdog
function master() {
  console.log(`Master started. Spawning ${WORKERS} workers.`);

  // Initialize Azure Watchdog in Master ONLY
  console.log('[Master] Initializing Azure Watchdog...');
  azureService.touchActivity(); // ensure file exists

  // Run the check every 5 minutes (default) or configured interval
  const checkInterval = process.env.IDLE_CHECK_INTERVAL_MS || 5 * 60 * 1000;

  setInterval(async () => {
    try {
      await azureService.checkIdleAndShutdown();
    } catch (err) {
      console.error("[Master] Watchdog Error:", err);
    }
  }, checkInterval);
}

// Worker process handles traffic
function start(id) {
  console.log(`Started worker ${id}`);

  server.listen(port);
  server.on('error', onError);
  server.on('listening', onListening);
}


/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
  console.log('Listening on ' + bind);

  // Log viewer URL for convenience
  console.log(`Go to viewer: http://localhost:${addr.port}/view`);
}
