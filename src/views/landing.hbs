<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>Cameron's Portfolio</title>
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
            color: #333;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        header {
            text-align: center;
            margin-bottom: 60px;
        }

        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 2.5em;
        }

        .subtitle {
            color: #666;
            font-size: 1.2em;
        }

        /* Status Indicator Styles */
        .status-container {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 10px;
            font-size: 0.9em;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: #ccc;
            margin-right: 8px;
            transition: background-color 0.3s;
        }

        .status-text {
            color: #666;
        }

        .status-live {
            background-color: #4CAF50;
            box-shadow: 0 0 8px rgba(76, 175, 80, 0.6);
        }

        .status-offline {
            background-color: #F44336;
        }

        .status-connecting {
            background-color: #FFC107;
        }

        .section-title {
            font-size: 1.5em;
            color: #2196F3;
            border-bottom: 2px solid #2196F3;
            padding-bottom: 10px;
            margin-bottom: 30px;
            margin-top: 50px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.15);
        }

        /* Updated card-image to support background images */
        .card-image {
            height: 200px;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #eee;
        }

        .card-image-placeholder {
            font-size: 3em;
            color: #aaa;
        }

        .card-content {
            padding: 25px;
        }

        .card-title {
            font-size: 1.25em;
            font-weight: bold;
            margin-bottom: 10px;
            color: #333;
        }

        .card-desc {
            color: #666;
            font-size: 0.95em;
            line-height: 1.5;
        }

        .footer {
            text-align: center;
            margin-top: 80px;
            color: #888;
            font-size: 0.9em;
        }

        /* Tooltip Styles */
        .card {
            position: relative;
            /* For tooltip positioning */
        }

        .tooltip {
            visibility: hidden;
            background-color: #333;
            color: #fff;
            text-align: left;
            border-radius: 6px;
            padding: 10px;
            position: absolute;
            z-index: 10;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            width: 250px;
            font-size: 0.85em;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            /* Prevent tooltip from interfering with clicks */
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .tooltip::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
            margin-left: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: #333 transparent transparent transparent;
        }

        .card:hover .tooltip {
            visibility: visible;
            opacity: 1;
        }

        .tooltip-row {
            margin-bottom: 4px;
        }

        .tooltip-label {
            font-weight: bold;
            color: #bbb;
            margin-right: 5px;
        }
    </style>
</head>

<body>
    <div class="container">
        <header>
            <h1>Cameron's Portfolio</h1>
            <div class="subtitle">Computational Design & Engineering</div>

            <div class="status-container" id="computeStatus">
                <div class="status-dot" id="statusDot"></div>
                <div class="status-text" id="statusText">Connecting to Compute Server...</div>
            </div>
        </header>

        <div class="section-title">Live Projects</div>
        <div class="grid">
            <a href="/cnc" class="card">
                <div class="card-image" style="background-image: url('/cnc/preview.png');"></div>
                <div class="card-content">
                    <div class="card-title">CNC Profiler</div>
                    <div class="card-desc">Interactive tool to generate GCode from DXF files using Rhino Compute.
                        Demonstrates real-time geometry processing.</div>
                </div>
            </a>
            <!-- Add more live projects here -->
        </div>

        <!-- Experiments Section -->
        <div class="section-title">Experiments</div>
        <div class="grid" id="experiments-grid">
            <div style="grid-column: 1/-1; text-align: center; color: #888; font-style: italic;">Loading
                experiments...</div>
        </div>

        <div class="footer">
            &copy; 2026 Cameron. Hand-crafted with Node.js and Rhino Compute.
        </div>
    </div>

    <script>
        // Compute Server Status Logic
        const statusDot = document.getElementById('statusDot');
        const statusText = document.getElementById('statusText');

        function updateStatus(state, message) {
            statusDot.className = 'status-dot'; // Reset
            statusText.textContent = message || 'Checking...';

            if (state === 'live') {
                statusDot.classList.add('status-live');
            } else if (state === 'offline') {
                statusDot.classList.add('status-offline');
            } else {
                // starting or any other state
                statusDot.classList.add('status-connecting');
            }
        }

        // 1. Trigger Wakeup on Load
        fetch('/wakeup', { method: 'POST' })
            .then(res => {
                console.log('Wakeup trigger sent:', res.status);
                // Optionally handle 200 vs 202
            })
            .catch(err => console.error('Wakeup trigger failed:', err));

        // 2. Poll Status
        function checkStatus() {
            fetch('/wakeStatus')
                .then(res => res.json())
                .then(data => {
                    updateStatus(data.status, data.message);
                })
                .catch(() => updateStatus('offline', 'AppServer Disconnected'));
        }

        // Initial check and interval
        updateStatus('connecting', 'Connecting...');
        checkStatus();
        setInterval(checkStatus, 5000); // Poll every 5 seconds

        // 3. Fetch and Display Experiments
        fetch('/api/definitions')
            .then(res => res.json())
            .then(definitions => {
                const grid = document.getElementById('experiments-grid');
                grid.innerHTML = ''; // Clear loading message

                const experiments = definitions.filter(d => d.category === 'experiment');

                if (experiments.length === 0) {
                    grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; color: #888;">No experiments found.</div>';
                    return;
                }

                experiments.forEach(def => {
                    const card = document.createElement('a');
                    card.href = '/view/' + def.name; // Use auto-generated UI
                    card.className = 'card';
                    card.innerHTML = `
                        <div class="card-image" style="height: 150px; background: #f9f9f9; color: #ccc; font-size: 2em;">🧪</div>
                        <div class="card-content">
                            <div class="card-title" style="font-size: 1.1em;">${def.name}</div>
                            <div class="card-desc" style="font-size: 0.9em;">
                                Grasshopper Experiment
                            </div>
                        </div>
                        <div class="tooltip">
                            ${def.description ? `<div class="tooltip-row">${def.description}</div>` : ''}
                            ${def.date ? `<div class="tooltip-row"><span class="tooltip-label">Date:</span>${def.date}</div>` : ''}
                            ${def.version ? `<div class="tooltip-row"><span class="tooltip-label">Version:</span>${def.version}</div>` : ''}
                        </div>
                    `;
                    grid.appendChild(card);
                });
            })
            .catch(err => {
                console.error("Failed to load experiments:", err);
                document.getElementById('experiments-grid').innerHTML = '<div style="color:red; text-align:center;">Error loading experiments.</div>';
            });
    </script>
</body>

</html>